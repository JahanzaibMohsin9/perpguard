# Copy to .env (never commit .env).
PORT=8787

# testnet only during the hackathon (money-safety rule)
HL_NETWORK=testnet

# Default address to watch until pairing exists (read-only; no key needed)
HL_WATCH_ADDRESS=

# How often to poll Hyperliquid, in milliseconds
POLL_MS=3000
# Trade-only API (agent) wallet key from app.hyperliquid-testnet.xyz/API. Can never withdraw.
# HL_WATCH_ADDRESS must be the master account that approved it. Leave empty for read-only.
HL_AGENT_KEY=

# Telegram bot (optional). Token from @BotFather; never commit it.
TELEGRAM_BOT_TOKEN=
# Needed where Telegram is blocked: your VPN's local HTTP proxy, e.g. http://127.0.0.1:17890
TELEGRAM_PROXY=
# Telegram Mini App: free public HTTPS URL via a Cloudflare quick tunnel (no account). Set to 'cloudflare' to enable.
TUNNEL=
