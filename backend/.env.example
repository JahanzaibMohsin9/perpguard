# Copy to .env (never commit .env).
PORT=8787

# testnet only during the hackathon (money-safety rule)
HL_NETWORK=testnet

# Default address to watch until pairing exists (read-only; no key needed)
HL_WATCH_ADDRESS=

# How often to poll Hyperliquid, in milliseconds
POLL_MS=3000
# Trade-only API (agent) wallet key from app.hyperliquid-testnet.xyz/API. Can never withdraw.
# HL_WATCH_ADDRESS must be the master account that approved it. Leave empty for read-only.
HL_AGENT_KEY=
